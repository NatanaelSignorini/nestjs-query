  "scripts": {
    "docker": "docker compose -f ./examples/docker-compose.yml",
    "prepare": "husky install",
    "build": "nx run-many -t build -p core,query-typeorm,query-graphql,query-rest,query-mongoose,query-sequelize,query-typegoose,query-mikro-orm",
    "test": "node --experimental-vm-modules ./node_modules/nx/dist/bin/nx.js run-many -t test -p core,query-typeorm,query-graphql --parallel=1",
    "test:core": "node --experimental-vm-modules ./node_modules/nx/dist/bin/nx.js run core:test",
    "test:e2e": "node --experimental-vm-modules ./node_modules/nx/dist/bin/nx.js e2e examples"
  },
